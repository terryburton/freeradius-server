--- a/wpa_supplicant/eapol_test.c
+++ b/wpa_supplicant/eapol_test.c
@@ -182,6 +182,24 @@
 	char buf[RADIUS_MAX_ATTR_LEN + 1];
 	const struct eap_hdr *hdr;
 	const u8 *pos;
+	/*
+	 * Reproducer: the peer's Response 2 with data in a TLS-based
+	 * method carries the Identifier of the previous Request, not of the
+	 * outstanding one.  Everything else is unchanged.
+	 */
+	static int data_responses;
+	static u8 copy[65536];
+
+	if (len > 6 && len <= sizeof(copy) && eap[0] == EAP_CODE_RESPONSE &&
+	    (eap[4] == 13 || eap[4] == 21 || eap[4] == 25 || eap[4] == 43 ||
+	     eap[4] == 55) &&
+	    ++data_responses == 2) {
+		os_memcpy(copy, eap, len);
+		copy[1]--;
+		printf("REPRODUCER: Response %d with data has Identifier %d instead of %d\n",
+		       data_responses, copy[1], eap[1]);
+		eap = copy;
+	}
 
 	wpa_printf(MSG_DEBUG, "Encapsulating EAP message into a RADIUS "
 		   "packet");
