#!/bin/bash
#
#  PEAP: the peer completes the TLS handshake, and then only ACKs, in
#  place of its data in the tunnel (patch/ack-after-handshake.patch).
#
#  RFC 5216 2.1.5 (which PEAP and TTLS use for their framing) defines a
#  server Request with no data only as the Start, or as the ACK of a
#  fragment from the peer.  Once the server has sent all of its tunnel
#  data, a peer's ACK acknowledges nothing.  The server should reject the
#  peer (FreeRADIUS's choice; RFC 5216 does not say), not answer with
#  empty Requests, nor start the tunnel's exchange again, until its round
#  limit; and it must never accept it (it never authenticated inside).
#
. "$(dirname "$0")/../common.sh"
build_eapol_test
run_eapol_test eapol_test.conf || true
grep -q '^REPRODUCER:' "$LOG" || fail "the peer never sent its ACK (did the server start PEAP?)"
got_access_accept && fail "the server accepted a peer that never authenticated inside the tunnel"
answer=$(answer_to_ack)
case "$answer" in
"code=4 "*) pass "the server answered the ACK with an EAP-Failure ($answer)" ;;
"") got_access_reject && pass "the server answered the ACK with an Access-Reject" ; fail "no answer to the ACK" ;;
*"code=1 "*"len=6"|*"code=1 "*"len=10") fail "the server answered the ACK, which acknowledges nothing, with an empty Request ($answer): the peer can only ACK it again" ;;
*) fail "the server answered the ACK, which acknowledges nothing, with $answer instead of an EAP-Failure: it carries on (or starts again) as if the peer had sent something" ;;
esac
